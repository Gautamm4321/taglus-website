// TEMPORARY development-only helper used once to import the old taglus.com blog posts.
// It refuses to run outside `next dev` and will be removed right after the import.
import { mkdir, writeFile } from "fs/promises";
import path from "path";
import { revalidatePath } from "next/cache";
import { prisma } from "../../lib/prisma";

const ORIGIN = "https://www.taglus.com";
const cors = {
  "Access-Control-Allow-Origin": ORIGIN,
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Access-Control-Allow-Headers": "content-type",
  "Access-Control-Allow-Private-Network": "true",
};
const devOnly = () => process.env.NODE_ENV !== "development";

export async function OPTIONS() {
  if (devOnly()) return new Response(null, { status: 404 });
  return new Response(null, { status: 204, headers: cors });
}

type Post = { slug: string; title: string; excerpt: string; content: string; imagePath: string; metaDescription: string; publishedAt: string };

export async function POST(req: Request) {
  if (devOnly()) return new Response(null, { status: 404 });
  const url = new URL(req.url);
  const kind = url.searchParams.get("kind");

  if (kind === "image") {
    const rel = url.searchParams.get("path") ?? "";
    if (!/^blog\/[a-z0-9-]+\/[a-z0-9-]+\.webp$/.test(rel)) return Response.json({ ok: false, error: "bad path" }, { status: 400, headers: cors });
    const file = path.join(process.cwd(), "public", rel);
    await mkdir(path.dirname(file), { recursive: true });
    const buf = Buffer.from(await req.arrayBuffer());
    await writeFile(file, buf);
    return Response.json({ ok: true, path: rel, bytes: buf.length }, { headers: cors });
  }

  if (kind === "posts") {
    const posts = (await req.json()) as Post[];
    const done: string[] = [];
    for (const p of posts) {
      const data = {
        title: p.title,
        excerpt: p.excerpt,
        content: p.content,
        imagePath: p.imagePath,
        metaDescription: p.metaDescription,
        published: true,
        publishedAt: new Date(p.publishedAt),
      };
      await prisma.blog.upsert({ where: { slug: p.slug }, create: { slug: p.slug, ...data }, update: data });
      done.push(p.slug);
    }
    revalidatePath("/blog");
    revalidatePath("/sitemap.xml");
    return Response.json({ ok: true, done }, { headers: cors });
  }

  return Response.json({ ok: false, error: "unknown kind" }, { status: 400, headers: cors });
}
